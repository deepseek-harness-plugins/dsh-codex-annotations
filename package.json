{
  "name": "@deepseekharness-plugin/dsh-codex-annotations",
  "version": "0.2.14",
  "icon": "./icon.svg",
  "description": "Codex 风格的原文批注：选区菜单、编号锚点、可选评论和原生引用发送",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json" },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE", "docs", "icon.svg", "locale/*.json"],
  "repository": { "type": "git", "url": "https://github.com/deepseek-harness-plugins/dsh-codex-annotations.git" },
  "keywords": ["dsh", "dsh-plugins", "deepseek-harness", "annotations", "codex"],
  "engines": { "node": ">=22.19.0", "dsh": ">=0.2.0-rc.2" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-api-session-controller", "@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-input-trigger"]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "screenshots": "npm run build && node scripts/capture-readme.mjs",
    "test:host": "node scripts/host-test.mjs"
  },
  "devDependencies": { "esbuild": "0.25.10", "playwright": "1.56.0" }
}
